# App Environment Configuration
PROJECT_NAME="Sistema de Liberación de Planta"
ENVIRONMENT=development

# Host Exposed Ports (Verified available ports)
POSTGRES_PORT=5440
BACKEND_PORT=8095
FRONTEND_PORT=5190

# Postgres Database
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_123
POSTGRES_DB=liberaciones_db

# Async SQLAlchemy DB URI (Internal Docker network connects via db:5432)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_123@db:5432/liberaciones_db

# Security & JWT
SECRET_KEY=super_secret_jwt_key_industrial_liberaciones_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Frontend URL & API base endpoint
FRONTEND_URL=http://localhost:5190
VITE_API_BASE_URL=http://localhost:8095/api/v1
